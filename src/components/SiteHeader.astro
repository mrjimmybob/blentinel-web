---
import favicon from '../assets/favicon.svg?url';
import ThemeToggle from './ThemeToggle.astro';
import { nav, site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const href = (h: string): string => (h.startsWith('#') ? `${base}${h}` : `${base}${h}`);
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href={base} aria-label={`${site.name} home`}>
      <img class="brand__mark" src={favicon} alt="" width="28" height="28" />
      <span>{site.name}</span>
    </a>
    <nav aria-label="Main">
      <ul class="nav">
        {nav.map((item) => (
          <li>
            <a href={href(item.href)}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="site-header__actions">
      <a class="gh" href={site.repo}>
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
          <path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
        <span>GitHub</span>
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bt-bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--bt-line);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    min-height: 4rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--bt-text);
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .brand__mark {
    width: 1.75rem;
    height: 1.75rem;
    object-fit: contain;
    border-radius: var(--radius-s);
  }
  .nav {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a,
  .gh {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.5rem;
    padding: 0 var(--space-3);
    border-radius: var(--radius-m);
    color: var(--bt-text-muted);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .nav a:hover,
  .gh:hover {
    color: var(--bt-text);
    background: var(--bt-bg-raised);
  }
  .site-header__actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  @media (max-width: 52rem) {
    .site-header__inner {
      flex-wrap: wrap;
      gap: 0 var(--space-3);
      padding-block: var(--space-2);
    }
    nav {
      order: 3;
      width: 100%;
      overflow-x: auto;
    }
    .nav a {
      padding: 0 var(--space-2);
      white-space: nowrap;
      font-size: 0.9rem;
    }
    .nav li:first-child a {
      padding-left: 0;
    }
  }
  @media (max-width: 26rem) {
    .gh span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
  }
</style>
